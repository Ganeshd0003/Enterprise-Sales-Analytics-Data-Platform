            "name": "price",
            "dataType": "double",
            "sourceColumn": "price",
            "sourceProviderType": "Numeric"
          },
          {
            "type": "calculated",
            "name": "order year",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": " YEAR(fact_sales[order_date])"
          }
        ],
        "partitions": [
          {
            "name": "fact_sales",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": " \t\t\t\tSELECT [gold].[fact_sales].*   FROM [gold].[fact_sales] ",
              "dataSource": "SqlServer GANESHSQLEXPRESS DataWarehouse"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Sales",
            "expression": " SUM(fact_sales[sales_amount])"
          },
          {
            "name": "Total Quantity",
            "expression": " SUM(fact_sales[quantity])"
          },
          {
            "name": "Total Orders",
            "expression": " DISTINCTCOUNT(fact_sales[order_number])"
          },
          {
            "name": "Total Customers",
            "expression": " DISTINCTCOUNT(dim_customers[customer_id])"
          },
          {
            "name": "Total Purchasing Customers",
            "expression": " DISTINCTCOUNT(fact_sales[customer_key])"
          },
          {
            "name": "Total Products",
            "expression": " DISTINCTCOUNT(fact_sales[product_key])"
          },
          {
            "name": "Average Order Value",
            "expression": " DIVIDE([Total Sales],[Total Orders])",
            "formatString": "0.00"
          },
          {
            "name": "Least Expensive Product Price",
            "expression": " MIN(fact_sales[price])"
          },
          {
            "name": "Most Expensive Product Price",
            "expression": " MAX(fact_sales[price])"
          },
          {
            "name": "Avg Product Price",
            "expression": " AVERAGE(fact_sales[price])",
            "formatString": "0.00"
          }
        ],
        "annotations": [
          {
            "name": "_TM_ExtProp_QueryDefinition",
            "value": " \t\t\t\tSELECT [gold].[fact_sales].*   FROM [gold].[fact_sales] "
